{
  "name": "fraud-transaction-simulator",
  "version": "1.0.0",
  "description": "Submits synthetic transactions to the real fraud detection pipeline",
  "main": "simulator.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
